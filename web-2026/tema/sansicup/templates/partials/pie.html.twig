{% set enlaces = page.header.evento.enlaces|default({'telegram': 'https://t.me/SanSiCup2026', 'instagram': 'https://www.instagram.com/icpc_umss/'}) %}
<footer class="pie">
  <div class="envoltura">
    <div class="creditos">
      <div class="credito">
        <span class="rotulo">Organiza</span>
        <span class="org"><img src="{{ url('theme://images/umss-escudo.png') }}" alt="" width="26" height="40"><span><b>ICPC UMSS</b><small>Informática – Sistemas</small></span></span>
      </div>
      <div class="credito">
        <span class="rotulo">Con el apoyo de</span>
        <span class="apoyos">
          <img class="scesi" src="{{ url('theme://images/scesi.svg') }}" alt="SCESI UMSS" width="61" height="40">
          <span class="org memi"><img src="{{ url('theme://images/centro-memi.png') }}" alt="" width="240" height="144"><b>Centro MEMI</b></span>
        </span>
      </div>
      <div class="credito">
        <span class="rotulo">Powered by</span>
        <img class="juki" src="{{ url('theme://images/juki-judge-blanco.svg') }}" alt="Juki Judge" width="104" height="52">
      </div>
    </div>
    <div class="redes">
      <a href="{{ enlaces.telegram }}">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M21 4 3 11l6 2.5L19 7l-7.5 8L18 20z"/></svg>
        t.me/SanSiCup2026
      </a>
      <a href="{{ enlaces.instagram }}">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r=".6" fill="currentColor"/></svg>
        @icpc_umss
      </a>
      <span class="lugar">Universidad Mayor de San Simón · Cochabamba, Bolivia</span>
    </div>
  </div>
</footer>
